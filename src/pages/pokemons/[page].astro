---
import type { GetStaticPaths } from 'astro';
import PokemonCard from '@components/pokemons/PokemonCard.astro';
import type { PokemonListResponse } from '@interfaces/pokemon-list.response';
import MainLayout from '@layouts/MainLayout.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const resp = await fetch('https://pokeapi.co/api/v2/pokemon?limit=151');
  const { results } = (await resp.json()) as PokemonListResponse;
  return paginate(results, { pageSize: 20 });
}) satisfies GetStaticPaths;

const title = 'Pokémon Static | Home';
const { page } = Astro.props;
const totalPages = page.lastPage;
console.log(page);

---

<MainLayout title="{title}">
  <h1 class="text-3xl">Listado de Pokémons</h1>
  <hr />
  <section
    class="grid
    grid-cols-1
    sm:grid-cols-4
    md:grid-cols-5
    gap-4 mt-5"
    aria-label="Listado de Pokémons"
  >
    {page.data.map(({ name, url }) => <PokemonCard name={name} url={url} />)}
  </section>

  <section class="flex mt-10 gap-2 items-center">
    {
      page.url.prev ? (
        <a class="btn" href={page.url.prev}>
          Anteriores
        </a>
      ) : (
        <span class="btn disable">Anteriores</span>
      )
    }

    {
      page.url.next ? (
        <a class="btn" href={page.url.next}>
          Siguientes
        </a>
      ) : (
        <span class="btn disable">Siguientes</span>
      )
    }

    <div class="flex flex-1"></div>

    <span>Página {page.currentPage} de {totalPages}</span>
  </section>
</MainLayout>

<style>
  @reference "tailwindcss";
  .btn {
    @apply bg-blue-500 m-2 p-2 text-white rounded-md; [cite: 5]
    /* Es buena práctica añadir cursor-pointer a los botones */
    cursor: pointer;
  }
  .disable {
    @apply bg-gray-600 text-gray-400;
    /* Estas utilidades mejoran la accesibilidad del botón deshabilitado */
    pointer-events: none;
    cursor: not-allowed;
  }
</style>
